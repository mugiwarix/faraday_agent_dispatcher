{
  "manifest_version": 1,
  "verdicts": [
    "REPRODUCED",
    "NOT_REPRODUCED",
    "INCONCLUSIVE"
  ],
  "automatic_statuses": [
    "TRUE_POSITIVE"
  ],
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "target": {
    "address_family": "ipv4",
    "transport": "tcp",
    "ports_per_task": 1,
    "min_port": 1,
    "max_port": 65535,
    "hostnames": false,
    "sni": false
  },
  "limits": {
    "max_tasks": 1024,
    "max_vulnerabilities": 10000
  },
  "id": "nmap-tls-protocols",
  "executor_id": "nmap",
  "handler": "nmap_tls",
  "title": "Nmap TLS 1.0 / 1.1 protocols",
  "description": "Single IPv4 TCP port; ssl-enum-ciphers through Faraday. Positive protocol evidence only.",
  "success_reason": "PROTOCOL_CIPHER_EVIDENCE",
  "rejection_reason": "Vulnerability name has no approved exact Nmap TLS 1.0/1.1 capability mapping.",
  "arguments": {
    "TARGET": [],
    "PORT_LIST": [],
    "SCRIPT_CMD": "ssl-enum-ciphers",
    "OPTION_PN": true,
    "SCRIPT_TIMEOUT": 30,
    "HOST_TIMEOUT": 60
  },
  "characteristics": {
    "credential_free": true,
    "positive_evidence_only": true,
    "reverse_dns_possible": true
  },
  "runtime": {
    "environment": {
      "NMAP_UNPRIVILEGED": "1"
    },
    "fixed_flags": [],
    "flag_order": []
  },
  "checks": {
    "TLSv1.0": {
      "name": "TLS Version 1.0 Protocol Detection",
      "aliases": [
        "TLS Version 1.0 Protocol Deprecated",
        "TLS Version 1.0 Deprecated Protocol",
        "TLS 1.0 Deprecated Protocol",
        "TLS 1.0 Protocol Detection",
        "TLS 1.0 Protocol Deprecated",
        "TLS 1.0 Supported",
        "TLS 1.0 Enabled",
        "TLSv1.0 Enabled",
        "TLSv1.0 is enabled"
      ],
      "cves": [],
      "flags": []
    },
    "TLSv1.1": {
      "name": "TLS Version 1.1 Protocol Detection",
      "aliases": [
        "TLS Version 1.1 Protocol Deprecated",
        "TLS Version 1.1 Deprecated Protocol",
        "TLS 1.1 Deprecated Protocol",
        "TLS 1.1 Protocol Detection",
        "TLS 1.1 Protocol Deprecated",
        "TLS 1.1 Supported",
        "TLS 1.1 Enabled",
        "TLSv1.1 Enabled",
        "TLSv1.1 is enabled"
      ],
      "cves": [],
      "flags": []
    }
  }
}
