{
  "manifest_version": 1,
  "verdicts": [
    "REPRODUCED",
    "NOT_REPRODUCED",
    "INCONCLUSIVE"
  ],
  "automatic_statuses": [
    "TRUE_POSITIVE"
  ],
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "target": {
    "address_family": "ipv4",
    "transport": "tcp",
    "ports_per_task": 1,
    "min_port": 1,
    "max_port": 65535,
    "hostnames": false,
    "sni": false
  },
  "limits": {
    "max_tasks": 1024,
    "max_vulnerabilities": 10000
  },
  "id": "testssl-3.2.4-ssl-tls",
  "executor_id": "testssl",
  "handler": "testssl",
  "title": "testssl.sh 3.2.4 SSL/TLS checks",
  "description": "Single scoped IPv4 TCP port; exact allowlisted checks and positive evidence only. No SNI, DNS, or external OCSP/CRL lookups.",
  "tool_version": "3.2.4",
  "success_reason": "TESTSSL_CHECK_EVIDENCE",
  "rejection_reason": "Vulnerability has no exact supported testssl check-name or CVE mapping.",
  "arguments": {
    "CHECK_IDS": []
  },
  "characteristics": {
    "credential_free": true,
    "positive_evidence_only": true,
    "dns": false,
    "phone_out": false
  },
  "runtime": {
    "environment": {
      "PHONE_OUT": "false"
    },
    "fixed_flags": [
      "--quiet",
      "--color",
      "0",
      "--warnings",
      "off",
      "--nodns",
      "none",
      "--connect-timeout",
      "5",
      "--openssl-timeout",
      "10"
    ],
    "flag_order": [
      "-p",
      "-s",
      "-f",
      "-S",
      "-h",
      "-U"
    ]
  },
